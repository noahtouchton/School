// Control Logic Flowchart
digraph Soil_Sampling_Robot {
	nodesep=0.6 rankdir=TB ranksep=0.8 splines=curved
	node [fontname=Arial fontsize=12 shape=rect style="rounded,filled"]
	Start [label=Start fillcolor="#333333" fontcolor=white shape=circle width=0.8]
	Iterate [label="Iterate over
each Soil Bag" fillcolor="#E1BEE7" height=1.2 shape=diamond]
	Gantry [label="Gantry Loop" fillcolor="#BBDEFB"]
	Display [label="Display Results" fillcolor="#C8E6C9" shape=parallelogram]
	End [label=End fillcolor="#333333" fontcolor=white shape=circle width=0.8]
	subgraph cluster_main {
		color=grey fontcolor=grey label="Processing Cycle" style=dashed
		Main [label="Main Loop" fillcolor="#FFF9C4" height=1 width=2]
		node [fillcolor=white shape=box style=filled]
		{
			rank=same
			Stir [label=Stir]
			Scoop [label=Scoop]
			Scan [label="Scan Soil
(AI Analysis)"]
			Unscoop [label=Unscoop]
		}
	}
	Start -> Iterate [label="Starting coords"]
	Iterate -> Gantry [label="Next Location
(If not last)" color="#1565C0" headport=n tailport=w]
	Gantry -> Iterate [label=Confirmation color="#2E7D32" headport=w tailport=s]
	Iterate -> Main [label="Start Process" headport=n tailport=s]
	Main -> Iterate [label="Process Complete" color="#D32F2F" headport=se tailport=n]
	Main -> Stir [label=Activate headport=n tailport=sw]
	Stir -> Main [label=Complete color="#2E7D32" headport=w tailport=e]
	Main -> Scoop [label=Activate headport=n tailport=s]
	Scoop -> Main [label=Complete color="#2E7D32" headport=s tailport=e]
	Main -> Scan [label="Send to AI" headport=n tailport=s]
	Scan -> Main [label="Soil Type" color="#2E7D32" headport=s tailport=e]
	Main -> Unscoop [label=Release headport=n tailport=se]
	Unscoop -> Main [label=Confirm color="#2E7D32" headport=e tailport=e]
	Iterate -> Display [label="If Last Iteration" headport=n tailport=e]
	Display -> End
}
