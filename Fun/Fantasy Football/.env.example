# Copy this file to .env and fill in values. .env is gitignored.

# LLM providers (used by the mock-draft tuning chat and AI Arena pick narration)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic

# Yahoo Fantasy Sports API (create a "Confidential Client" app at
# https://developer.yahoo.com/apps/create/ with the redirect URI below — Yahoo
# requires https, so after approving you'll paste the resulting URL back into
# the app's My Yahoo Team page. Leave the API-permission checkboxes unchecked.)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:8000/yahoo/auth/callback

# ESPN league link (leave blank until you're ready to connect a real league)
ESPN_LEAGUE_ID=
ESPN_YEAR=2025
ESPN_S2=
ESPN_SWID=

# Historical data range pulled by the ingestion pipeline
INGESTION_START_YEAR=2016
INGESTION_END_YEAR=2025
